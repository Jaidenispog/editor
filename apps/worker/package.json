    "test": "vitest run --exclude \"test/**/*.integration.test.ts\"",
    "build": "echo 'worker runs from TypeScript source via tsx'",
    "test:integration": "vitest run test/pipeline.integration.test.ts"
  },
  "dependencies": {
    "@studio/ai": "workspace:*",
    "@studio/config": "workspace:*",
