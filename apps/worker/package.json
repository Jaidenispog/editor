    "@studio/media": "workspace:*",
    "@studio/queue": "workspace:*",
    "@studio/storage": "workspace:*",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "execa": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
