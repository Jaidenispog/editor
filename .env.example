# Studio Assistant settings. Copy to .env at the repository root:  cp .env.example .env
# The web app and the worker both read this one file (values already set in the environment win).
# Every variable is validated at start-up by packages/config/src/index.ts.
#
# Never commit .env. Secrets (passwords, API keys) stay blank here; fill them in only in your own .env or in
# your hosting provider's secret store. Lines starting with "#" are ignored; leave optional numbers commented
# out rather than blank, because a blank number is rejected.

# ---------------------------------------------------------------------------------------------------------
# Basics
# ---------------------------------------------------------------------------------------------------------
# development | test | production (Docker Compose sets production for you)
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# The address people use to open the app. Must be the public https:// address in production: it decides the
# Secure cookie flag and which origins the CSRF guard accepts.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ---------------------------------------------------------------------------------------------------------
# Local database from `bash scripts/local-postgres.sh start` (port 5433, no password, 127.0.0.1 only).
# Docker Compose ignores this value and connects to its own "db" service using POSTGRES_PASSWORD below.
# Supabase: use the session-mode pooler (port 5432) or the direct connection; see docs/deployment.md.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/studio_assistant
# Optional separate connection for the job queue (pg-boss needs a session-mode connection, e.g. Supabase's
# session pooler on port 5432). Leave commented out to use DATABASE_URL.
# QUEUE_DATABASE_URL=
# Optional connection budgets (whole numbers, 1-100). Leave commented out for the defaults:
# app queries 10 (web) / 8 (worker); job queue 3 (web) / 6 (worker). On a small hosted database such as
# Supabase Micro, see the budget in docs/deployment.md (e.g. worker DB_POOL_MAX=4 and QUEUE_POOL_MAX=3).
# DB_POOL_MAX=
# QUEUE_POOL_MAX=

# Docker Compose only: password for the bundled "db" service (required when you use docker-compose.yml).
# It is placed inside a connection URL, so use letters and digits only. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------------------------------------
# REQUIRED, at least 32 characters. Signs session cookies and media links. Generate with:
#   openssl rand -base64 48
# Changing it signs everyone out and, unless APP_ENCRYPTION_KEY is set, makes stored integration tokens unreadable.
APP_SECRET=
# Optional 32-byte key (base64) for encrypting integration tokens at rest. Blank = derived from APP_SECRET.
# Generate with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------------------------------------
# Media storage (private; browsers only ever get expiring links)
# ---------------------------------------------------------------------------------------------------------
# local = files on this machine's disk; s3 = Supabase Storage (S3 protocol), Cloudflare R2 or Amazon S3.
STORAGE_DRIVER=local
# Folder for the local driver. Relative paths resolve against the repository root (/app inside the containers).
STORAGE_LOCAL_ROOT=./data/storage
# S3-compatible storage (only used when STORAGE_DRIVER=s3). Supabase example:
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3   S3_REGION=<your project region>
#   S3_FORCE_PATH_STYLE=true   (keys are created under Storage > S3 Connection in the Supabase dashboard)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for Supabase Storage and most S3-compatible services; false for Amazon S3 virtual-hosted buckets.
S3_FORCE_PATH_STYLE=true
# How long a media link stays valid, in seconds (60-86400).
MEDIA_LINK_TTL_SECONDS=3600
# Largest single upload in bytes (default 6 GiB, enough for several minutes of iPhone 4K footage).
MAX_UPLOAD_BYTES=6442450944

# ---------------------------------------------------------------------------------------------------------
# Worker (video processing)
# ---------------------------------------------------------------------------------------------------------
# Scratch space for renders; needs several GB free. Relative paths resolve against the repository root.
WORKER_TMP_DIR=./tmp/worker
# Jobs processed at the same time (1-8). Renders are CPU-heavy: keep 1 unless the machine has 4+ cores.
WORKER_CONCURRENCY=1
# FFmpeg 6 or newer with libx264, libass and zscale. Full paths if they are not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# CPU threads FFmpeg may use per render (0 = automatic).
FFMPEG_THREADS=0

# ---------------------------------------------------------------------------------------------------------
# AI (optional). Without a key, the built-in rules planner makes the edits and shot labels come from the
# owner's clip tags. Paid API calls only happen once the owner adds a key.
# ---------------------------------------------------------------------------------------------------------
# none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# Model that plans the five edits (structured output).
AI_PLANNER_MODEL=claude-opus-5-5
# low | medium | high
AI_PLANNER_EFFORT=medium
# Cheaper model that labels sampled frames (before, cutting, fade detail, result, reaction).
AI_VISION_MODEL=claude-haiku-5-5
# Upper bound on frames sent to the vision model per clip (2-40).
AI_VISION_MAX_FRAMES_PER_CLIP=10
# Speech-to-text for captions: none | deepgram | openai. Deepgram (Nova-3, word timestamps) is recommended:
# create a project API key in the Deepgram Console and keep it on the server only. Captions stay off with "none".
# Clip audio is sent to a US speech-to-text provider; let clients and staff know.
TRANSCRIPTION_PROVIDER=none
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Optional alternative: OpenAI whisper-1. OpenAI has announced it shuts down on 26 February 2027, and its newer
# transcription models return no timestamps, so they cannot time captions.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ---------------------------------------------------------------------------------------------------------
# Later stages (optional). Each integration shows "needs setup" in the app until these are filled in.
# Nothing here is needed to edit videos. Posting by hand, the review link and copy-paste website changes always work.
# ---------------------------------------------------------------------------------------------------------
# Instagram publishing (Meta app with Facebook Login for Business). All three are needed before the app offers
# "Connect Instagram"; until then, download the export and post it from your phone.
META_APP_ID=
META_APP_SECRET=
# The Login for Business configuration id from the Meta app dashboard.
META_LOGIN_CONFIG_ID=
# Graph API version for every Meta call (e.g. v26.0). The connection check records the version that worked.
META_GRAPH_VERSION=v26.0
# Not used: TikTok has no direct posting in this app. Left here so older .env files still load.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok automatic posting through Zernio (optional, Stage C): none | zernio. "none" keeps manual posting only.
TIKTOK_PUBLISH_PROVIDER=none
# Zernio API address (https://...) and the secret it signs webhooks with. Only read when the provider is zernio.
ZERNIO_API_BASE_URL=
ZERNIO_WEBHOOK_SECRET=

# Trends: a YouTube Data API key (restricted to that API) to show YouTube's Australian popular chart.
YOUTUBE_API_KEY=

# Square appointments: sandbox | production
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# The exact webhook address registered in Square, only if it differs from APP_URL + /api/webhooks/square
# (Square signs the address it was given, so they must match exactly).
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Email through Postmark: none | postmark. With "none", emails can be written and saved but nothing is sent.
EMAIL_PROVIDER=none
POSTMARK_SERVER_TOKEN=
# Postmark message stream ids: transactional (follow-ups, review requests) and broadcast (campaigns).
POSTMARK_TRANSACTIONAL_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
# Username and password you type into Postmark's webhook settings (Basic authentication on our webhook).
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=
# The sender, e.g. "Studio Name <hello@your-domain.com.au>". Required when EMAIL_PROVIDER=postmark.
EMAIL_FROM=
# Not used: Postmark replaced Resend. Left here so older .env files still load.
RESEND_API_KEY=
# Optional Google Maps (Places API) key, only to show your own Google rating and review count.
GOOGLE_MAPS_API_KEY=

# Google sign-in for Business Profile (reviews) and Search Console (website search data). Each is connected
# separately in Settings → Integrations; both use this one Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Website: model used only when you press "Suggest wording" on a website change (needs AI_PROVIDER=anthropic).
AI_WEBSITE_MODEL=claude-haiku-5-5

# Test only: local fake servers for the automated tests. Ignored unless NODE_ENV=test; leave blank.
META_GRAPH_BASE_URL=
META_RUPLOAD_BASE_URL=
# Meta's login dialog host (normally https://www.facebook.com); only the Stage B browser test points it at its fake.
META_DIALOG_BASE_URL=
SQUARE_API_BASE_URL=

# ---------------------------------------------------------------------------------------------------------
# Command-line helpers (not read by the app itself)
# ---------------------------------------------------------------------------------------------------------
# `pnpm db:seed` creates the owner account when both are set (password at least 10 characters).
# The /setup page in the browser does the same thing without these.
# OWNER_EMAIL=
# OWNER_PASSWORD=
# OWNER_NAME=Owner
# Admin connection for the test suites; each test file creates and drops its own throwaway database.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres

# Docker Compose only: which address and port the web container is published on. 127.0.0.1 keeps it private
# to this machine (a reverse proxy such as Caddy then serves it over https).
# WEB_BIND=127.0.0.1
# WEB_PORT=3000
# Docker Compose only: user id the containers run as. Set it to the owner of ./data on the host (`id -u`).
# APP_UID=1001
